{{- /* sitemapindex - 引用各语言子sitemap */ -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>{{ .Site.BaseURL }}/en/sitemap.xml</loc>
    <lastmod>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
  </sitemap>
  <sitemap>
    <loc>{{ .Site.BaseURL }}/zh/sitemap.xml</loc>
    <lastmod>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
  </sitemap>
  <sitemap>
    <loc>{{ .Site.BaseURL }}/ar/sitemap.xml</loc>
    <lastmod>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
  </sitemap>
</sitemapindex>

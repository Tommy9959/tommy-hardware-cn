# ==================== 基本面分析 ====================
def get_fundamental_data(stock_code, stock_name):
    """获取基本面数据"""
    print(f"\n📊 基本面分析 - {stock_name}({stock_code})")
    print("=" * 60)
    
    try:
        # 获取个股信息
        stock_info = ak.stock_individual_info_em(symbol=stock_code)
        
        # 获取财务指标
        try:
            financial_data = ak.stock_financial_analysis_indicator(symbol=stock_code)
            latest_financial = financial_data.iloc[0] if len(financial_data) > 0 else None
        except:
            latest_financial = None
        
        # 获取主营业务
        try:
            business = ak.stock_profile_em(symbol=stock_code)
            main_business = business.get('主营业务', '暂无数据')
        except:
            main_business = '暂无数据'
        
        print(f"主营业务：{main_business[:50]}...")
        
        if latest_financial is not None:
            print(f"\n核心财务指标（最新报告期）:")
            print(f"  每股收益 (EPS): {latest_financial.get('基本每股收益', 'N/A')} 元")
            print(f"  净资产收益率 (ROE): {latest_financial.get('加权净资产收益率', 'N/A')}%")
            print(f"  营业收入增长率：{latest_financial.get('营业收入同比增长率', 'N/A')}%")
            print(f"  净利润增长率：{latest_financial.get('归属净利润同比增长率', 'N/A')}%")
            print(f"  资产负债率：{latest_financial.get('资产负债率', 'N/A')}%")
        
        return {
            'main_business': main_business,
            'financial': latest_financial
        }
    except Exception as e:
        print(f"❌ 获取基本面数据失败：{e}")
        return None

# ==================== 技术面分析 ====================
def get_technical_data(stock_code, stock_name):
    """获取技术面数据"""
    print(f"\n📉 技术面分析 - {stock_name}({stock_code})")
    print("=" * 60)
    
    try:
        # 获取日线数据
        df = ak.stock_zh_a_hist(symbol=stock_code, period="daily", adjust="qfq")
        
        if len(df) < 60:
            print("❌ 数据不足，无法进行技术分析")
            return None
        
        latest = df.iloc[-1]
        prev = df.iloc[-2]
        
        # 计算均线
        ma5 = df['收盘'].rolling(5).mean().iloc[-1]
        ma10 = df['收盘'].rolling(10).mean().iloc[-1]
        ma20 = df['收盘'].rolling(20).mean().iloc[-1]
        ma60 = df['收盘'].rolling(60).mean().iloc[-1]
        
        # 计算 MACD
        close = df['收盘']
        ema12 = close.ewm(span=12).mean()
        ema26 = close.ewm(span=26).mean()
        dif = ema12 - ema26
        dea = dif.ewm(span=9).mean()
        macd = (dif - dea) * 2
        
        # 计算支撑位和压力位
        recent_high = df['高'].iloc[-20:].max() if '高' in df.columns else df['最高'].iloc[-20:].max()
        recent_low = df['低'].iloc[-20:].min() if '低' in df.columns else df['最低'].iloc[-20:].min()
        
        # 成交量分析
        vol_col = '成交量' if '成交量' in df.columns else 'volume'
        vol_ma5 = df[vol_col].rolling(5).mean().iloc[-1]
        vol_ma20 = df[vol_col].rolling(20).mean().iloc[-1]
        
        print(f"\n最新价格：{latest['收盘']} 元 (涨跌幅：{latest['涨跌幅']}%)")
        print(f"\n均线系统:")
        print(f"  MA5: {ma5:.2f} 元 {'📈' if latest['收盘'] > ma5 else '📉'}")
        print(f"  MA10: {ma10:.2f} 元 {'📈' if latest['收盘'] > ma10 else '📉'}")
        print(f"  MA20: {ma20:.2f} 元 {'📈' if latest['收盘'] > ma20 else '📉'}")
        print(f"  MA60: {ma60:.2f} 元 {'📈' if latest['收盘'] > ma60 else '📉'}")
        
        print(f"\nMACD 指标:")
        print(f"  DIF: {dif.iloc[-1]:.4f}")
        print(f"  DEA: {dea.iloc[-1]:.4f}")
        print(f"  MACD: {macd.iloc[-1]:.4f} {'🔴 红柱' if macd.iloc[-1] > 0 else '🟢 绿柱'}")
        
        print(f"\n支撑位/压力位:")
        print(f"  支撑位：{recent_low:.2f} 元 (近 20 日低点)")
        print(f"  压力位：{recent_high:.2f} 元 (近 20 日高点)")
        
        print(f"\n成交量:")
        print(f"  今日成交量：{latest['成交量']} 手")
        print(f"  5 日均量：{vol_ma5:.0f} 手")
        print(f"  20 日均量：{vol_ma20:.0f} 手")
        print(f"  量能状态：{'📈 放量' if latest['成交量'] > vol_ma20 * 1.5 else '📊 正常' if latest['成交量'] > vol_ma20 * 0.8 else '📉 缩量'}")
        
        # 趋势判断
        trend = "多头" if latest['收盘'] > ma20 > ma60 else "空头" if latest['收盘'] < ma20 < ma60 else "震荡"
        print(f"\n趋势判断：{trend}")
        
        return {
            'latest_price': latest['收盘'],
            'change_pct': latest['涨跌幅'],
            'ma5': ma5,
            'ma10': ma10,
            'ma20': ma20,
            'ma60': ma60,
            'support': recent_low,
            'resistance': recent_high,
            'trend': trend,
            'volume_status': '放量' if latest['成交量'] > vol_ma20 * 1.5 else '正常' if latest['成交量'] > vol_ma20 * 0.8 else '缩量'
        }
    except Exception as e:
        print(f"❌ 获取技术面数据失败：{e}")
        return None

# ==================== 资金面分析 ====================
def get_capital_flow(stock_code, stock_name):
    """获取资金面数据"""
    print(f"\n💰 资金面分析 - {stock_name}({stock_code})")
    print("=" * 60)
    
    try:
        # 获取资金流向
        try:
            fund_flow = ak.stock_individual_fund_flow(symbol=stock_code)
            latest_flow = fund_flow.iloc[-1] if len(fund_flow) > 0 else None
            
            if latest_flow is not None:
                print(f"\n主力资金:")
                print(f"  主力净流入：{latest_flow.get('主力净流入-净额', 'N/A')} 万元")
                print(f"  大单净流入：{latest_flow.get('大单净流入 - 净额', 'N/A')} 万元")
                print(f"  中单净流入：{latest_flow.get('中单净流入 - 净额', 'N/A')} 万元")
                print(f"  小单净流入：{latest_flow.get('小单净流入 - 净额', 'N/A')} 万元")
        except Exception as e:
            print(f"  主力资金数据暂不可用")
        
        # 获取北向资金（仅沪深股通标的）
        try:
            north_flow = ak.stock_hsgt_north_net_flow_in_em(symbol=stock_code)
            if len(north_flow) > 0:
                latest_north = north_flow.iloc[-1]
                print(f"\n北向资金:")
                print(f"  净流入：{latest_north.get('净流入', 'N/A')} 万元")
        except:
            print(f"  北向资金数据暂不可用（非沪深股通标的）")
        
        # 获取换手率
        try:
            stock_info = ak.stock_individual_info_em(symbol=stock_code)
            turnover = stock_info[stock_info['item'] == '换手率'].iloc[0]['value']
            print(f"\n换手率：{turnover}%")
        except:
            print(f"  换手率数据暂不可用")
        
        return {
            'fund_flow': latest_flow,
        }
    except Exception as e:
        print(f"❌ 获取资金面数据失败：{e}")
        return None

# ==================== 估值分析 ====================
def get_valuation_data(stock_code, stock_name):
    """获取估值数据"""
    print(f"\n💎 估值分析 - {stock_name}({stock_code})")
    print("=" * 60)
    
    try:
        # 获取估值指标
        valuation = ak.stock_value_em(symbol=stock_code)
        latest_val = valuation.iloc[-1] if len(valuation) > 0 else None
        
        if latest_val is not None:
            pe = latest_val.get('市盈率', 'N/A')
            pb = latest_val.get('市净率', 'N/A')
            ps = latest_val.get('市销率', 'N/A')
            
            print(f"\n当前估值:")
            print(f"  市盈率 (PE): {pe}")
            print(f"  市净率 (PB): {pb}")
            print(f"  市销率 (PS): {ps}")
            
            # 估值判断
            try:
                if isinstance(pe, (int, float)) and pe > 0:
                    pe_level = "🔴 高估" if pe > 50 else "🟡 合理" if pe > 20 else "🟢 低估"
                    print(f"\n估值水平：{pe_level} (PE={pe})")
            except:
                pass
        
        return {
            'pe': pe,
            'pb': pb,
            'ps': ps
        }
    except Exception as e:
        print(f"❌ 获取估值数据失败：{e}")
        return None

# ==================== 风险分析 ====================
def get_risk_data(stock_code, stock_name):
    """获取风险点"""
    print(f"\n⚠️ 风险提示 - {stock_name}({stock_code})")
    print("=" * 60)
    
    risks = []
    
    try:
        # 检查解禁
        try:
            ban_list = ak.stock_limited_hold_release_em(symbol=stock_code)
            if len(ban_list) > 0:
                latest_ban = ban_list.iloc[0]
                risks.append(f"🔒 解禁：{latest_ban.get('解禁日期', 'N/A')} 解禁 {latest_ban.get('解禁数量', 'N/A')} 股")
        except:
            pass
        
        # 检查减持
        try:
            reduce_list = ak.stock_share_hold_change_em(symbol=stock_code)
            if len(reduce_list) > 0:
                risks.append("📉 存在股东减持记录")
        except:
            pass
        
        # 检查业绩预告
        try:
            forecast = ak.stock_performance_forecast_em(symbol=stock_code)
            if len(forecast) > 0:
                latest_forecast = forecast.iloc[0]
                if '预减' in str(latest_forecast) or '亏损' in str(latest_forecast):
                    risks.append("⚠️ 业绩预告：可能存在业绩下滑")
        except:
            pass
        
        if len(risks) == 0:
            risks.append("✅ 暂无重大风险事项")
        
        for risk in risks:
            print(f"  {risk}")
        
        return {'risks': risks}
    except Exception as e:
        print(f"❌ 获取风险数据失败：{e}")
        return {'risks': ['数据获取失败']}

# ==================== 操作建议 ====================
def generate_recommendation(tech_data, valuation_data, risk_data):
    """生成操作建议"""
    print(f"\n🎯 操作参考")
    print("=" * 60)
    
    if tech_data is None:
        print("❌ 数据不足，无法生成操作建议")
        return
    
    latest_price = tech_data['latest_price']
    support = tech_data['support']
    resistance = tech_data['resistance']
    trend = tech_data['trend']
    
    # 计算建议位
    suggest_buy = support * 1.02  # 支撑位上方 2%
    suggest_sell = resistance * 0.98  # 压力位下方 2%
    stop_loss = support * 0.95  # 支撑位下方 5%
    
    print(f"\n建议关注位：{suggest_buy:.2f} 元 (支撑位上方 2%)")
    print(f"建议止盈位：{suggest_sell:.2f} 元 (压力位下方 2%)")
    print(f"止损位：{stop_loss:.2f} 元 (支撑位下方 5%)")
    print(f"\n当前趋势：{trend}")
    
    # 综合判断
    if trend == "多头" and tech_data['change_pct'] > 0:
        print("\n📈 综合判断：偏多，可逢低关注")
    elif trend == "空头" and tech_data['change_pct'] < 0:
        print("\n📉 综合判断：偏空，建议观望")
    else:
        print("\n📊 综合判断：震荡，高抛低吸")
    
    # 风险提醒
    if len(risk_data.get('risks', [])) > 0 and '暂无' not in str(risk_data['risks']):
        print("\n⚠️ 特别提示：存在风险事项，请谨慎决策")

# ==================== 完整分析流程 ====================
def analyze_stock(stock_info):
    """完整分析一只股票"""
    stock_code = stock_info['code']
    stock_name = stock_info['name']
    
    print("\n" + "📈" * 30)
    print(f"  A 股量化分析报告 - {stock_name}({stock_code})")
    print("📈" * 30)
    
    # 基本面
    fundamental_data = get_fundamental_data(stock_code, stock_name)
    
    # 技术面
    technical_data = get_technical_data(stock_code, stock_name)
    
    # 资金面
    capital_data = get_capital_flow(stock_code, stock_name)
    
    # 估值
    valuation_data = get_valuation_data(stock_code, stock_name)
    
    # 风险
    risk_data = get_risk_data(stock_code, stock_name)
    
    # 操作建议
    generate_recommendation(technical_data, valuation_data, risk_data)
    
    return {
        'stock': stock_info,
        'fundamental': fundamental_data,
        'technical': technical_data,
        'capital': capital_data,
        'valuation': valuation_data,
        'risk': risk_data
    }

# ==================== 主函数 ====================
def main():
    """主函数"""
    print(RISK_DISCLAIMER)
    
    results = []
    for stock in CONFIG['stocks']:
        result = analyze_stock(stock)
        results.append(result)
        print("\n" + "=" * 60 + "\n")
    
    # 保存报告
    report_time = datetime.now().strftime('%Y-%m-%d_%H-%M-%S')
    print(f"\n✅ 分析完成！时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"📁 报告已保存至：{CONFIG['output_dir']}/stock_analysis_{report_time}.txt")
    
    # 推送到微信
    send_wechat_notify(results, report_time)
    
    return results

# ==================== 微信推送 ====================
def send_wechat_notify(results, report_time):
    """发送微信推送"""
    print("\n📱 准备微信推送...")
    
    try:
        # 构建推送消息
        message = "📈 A 股量化分析报告\n"
        message += "━" * 30 + "\n"
        message += f"📅 时间：{report_time}\n\n"
        
        for result in results:
            stock_name = result.get('stock_name', 'Unknown')
            stock_code = result.get('stock_code', 'Unknown')
            tech_data = result.get('technical_data', {})
            
            if tech_data and tech_data.get('latest_price'):
                price = tech_data.get('latest_price', 0)
                change_pct = tech_data.get('change_pct', 0)
                trend = tech_data.get('trend', 'N/A')
                
                emoji = '🟢' if change_pct > 0 else '🔴' if change_pct < 0 else '⚪'
                
                message += f"{emoji} {stock_name}({stock_code})\n"
                message += f"   价格：¥{price:.2f} ({change_pct:+.2f}%)\n"
                message += f"   趋势：{trend}\n\n"
        
        message += "═" * 30 + "\n"
        message += "⚠️ 风险提示：不构成投资建议\n"
        message += "═" * 30
        
        # 执行推送
        result = subprocess.run(
            ['openclaw', 'message', 'send', 
             '-t', CONFIG['wechat_user'],
             '--channel', 'openclaw-weixin',
             '--account', CONFIG['account_id'],
             '-m', message],
            capture_output=True, text=True, timeout=30
        )
        
        if result.returncode == 0:
            print("✅ 微信推送成功")
        else:
            print(f"❌ 微信推送失败：{result.stderr}")
            
    except Exception as e:
        print(f"❌ 推送异常：{str(e)}")

if __name__ == "__main__":
    main()
